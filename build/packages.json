{
  "$comment": "The packages built by CI, in build order, and the shared build files whose change marks every package as changed. Read by the scripts in build/ and the GitHub workflows. variableSuffix names each package's version variables: DATASTANDARDIZER_<variableSuffix>__<STABLE|CURRENT|NEXT>_<part>. A package's tests run on each of its testRunners (defaultTestRunners when it has none). The deprecated packages test on Windows only, as on Azure DevOps, until their removal (#98).",
  "sharedBuildFiles": [
    "Directory.Build.props",
    "Directory.Build.targets",
    "Directory.Packages.props",
    "src/Directory.Build.props",
    "src/Directory.Build.targets"
  ],
  "defaultTestRunners": [
    "ubuntu-24.04",
    "windows-2025"
  ],
