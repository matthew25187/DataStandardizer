{
  "$comment": "The packages built by CI, in build order, and the shared build files whose change marks every package as changed. Read by the scripts in build/ and the GitHub workflows. variableSuffix names each package's version variables: DATASTANDARDIZER_<variableSuffix>__<STABLE|CURRENT|NEXT>_<part>. A package builds on its buildRunner and tests on each of its testRunners (defaultBuildRunner and defaultTestRunners when it has none).",
  "sharedBuildFiles": [
    "Directory.Build.props",
    "Directory.Build.targets",
    "Directory.Packages.props",
    "src/Directory.Build.props",
    "src/Directory.Build.targets"
  ],
  "defaultTestRunners": [
    "ubuntu-24.04",
    "windows-2025"
  ],
  "defaultBuildRunner": "ubuntu-24.04",
  "packages": [
    {
      "packageName": "DataStandardizer.Core",
      "packageSourcePath": "src/DataStandardizer.Core",
      "variableSuffix": "CORE",
      "enableTests": true
    },
    {
      "packageName": "DataStandardizer.Chronology",
      "packageSourcePath": "src/DataStandardizer.Chronology",
      "variableSuffix": "CHRONOLOGY",
      "enableTests": true
    },
    {
      "packageName": "DataStandardizer.Communication",
      "packageSourcePath": "src/DataStandardizer.Communication",
      "variableSuffix": "COMMUNICATION",
      "enableTests": true
    },
    {
      "packageName": "DataStandardizer.File.CSV",
      "packageSourcePath": "src/DataStandardizer.File.CSV",
      "variableSuffix": "FILE_CSV",
      "enableTests": true
    },
    {
      "packageName": "DataStandardizer.File.iCal",
      "packageSourcePath": "src/DataStandardizer.File.iCal",
      "variableSuffix": "FILE_ICAL",
      "enableTests": true
    },
    {
      "packageName": "DataStandardizer.Geography",
      "packageSourcePath": "src/DataStandardizer.Geography",
      "variableSuffix": "GEOGRAPHY",
      "enableTests": true
    },
    {
      "packageName": "DataStandardizer.Language",
      "packageSourcePath": "src/DataStandardizer.Language",
      "variableSuffix": "LANGUAGE",
      "enableTests": true
    },
    {
      "packageName": "DataStandardizer.LanguageTag",
      "packageSourcePath": "src/DataStandardizer.LanguageTag",
      "variableSuffix": "LANGUAGETAG",
      "enableTests": true
    },
    {
      "packageName": "DataStandardizer.Money",
      "packageSourcePath": "src/DataStandardizer.Money",
      "variableSuffix": "MONEY",
      "enableTests": true
    }
  ]
}
