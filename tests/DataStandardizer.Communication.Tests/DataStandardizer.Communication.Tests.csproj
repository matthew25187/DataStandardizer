<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DataStandardizer.Communication\DataStandardizer.Communication.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Turns off xUnit's AppDomain isolation on .NET Framework, where marshalling each of the E.164 theories' tens of
         thousands of cases across the AppDomain boundary takes the net48 run from seconds to over ten minutes. -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
