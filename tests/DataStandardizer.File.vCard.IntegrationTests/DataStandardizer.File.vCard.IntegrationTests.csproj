<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DataStandardizer.File.vCard\DataStandardizer.File.vCard.csproj" />
    <!-- Builds the netstandard1.1 target too, without referencing it, so that JcardPlatformTests can check it has no jCard types.
         CopyNetStandard11Build copies it to the netstandard1.1 folder of the output. -->
    <ProjectReference Include="..\..\src\DataStandardizer.File.vCard\DataStandardizer.File.vCard.csproj" SetTargetFramework="TargetFramework=netstandard1.1"
                      ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" Private="false" OutputItemType="NetStandard11Build" />
  </ItemGroup>

  <Target Name="CopyNetStandard11Build" AfterTargets="CopyFilesToOutputDirectory">
    <Copy SourceFiles="@(NetStandard11Build)" DestinationFolder="$(OutDir)netstandard1.1" SkipUnchangedFiles="true" />
  </Target>

</Project>
